# ============================================================
# CYCLO-VISION — Environment Variables (example)
# Copy this file to `.env` and fill in your values.
# NEVER commit real secrets.
# ============================================================

# --- Backend / Server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
APP_ENV=development

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL Database ---
DATABASE_URL=postgresql://cyclo:cyclo_pass@localhost:5432/cyclo_vision
# Display-friendly DB connection parts (used by setup scripts)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cyclo_vision
DB_USER=cyclo
DB_PASSWORD=cyclo_pass

# --- ML / Inference ---
# Model mode: "model" (trained model) | "demo" (prototype inference)
# If "model", a weights file must exist under models/
ML_MODE=demo
MODEL_PATH=models/cyclo_cnn.pt
# Minimum pixel dimension for resized inference input
INPUT_SIZE=256

# --- Demo sample images location ---
DEMO_DATA_DIR=data/demo

# --- Upload constraints ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.tif,.tiff

# --- Security ---
# Secret used for any signing (avoid in prototype). Generate via: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-please-generate-a-random-secret

# --- Optional: external satellite data (leave blank unless integrated) ---
INSAT_API_URL=
GOES_API_URL=
NASA_EARTHDATA_TOKEN=